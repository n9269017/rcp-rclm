{
  "$defs": {
    "attempt": {
      "additionalProperties": false,
      "properties": {
        "active_store_package_hash_after": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "active_store_package_hash_before": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "candidate_phase6_tree_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "candidate_semantic_package_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "challenge_commitment_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "challenge_index": {
          "minimum": 0,
          "type": "integer"
        },
        "gate_d_report_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "gate_e_report_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "global_attempt_index": {
          "minimum": 0,
          "type": "integer"
        },
        "hidden_task_report_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "local_attempt_index": {
          "minimum": 0,
          "type": "integer"
        },
        "phase7_ledger_entry_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "program_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "program_variant": {
          "enum": [
            "probe",
            "recover",
            "direct"
          ]
        },
        "proposal_enumeration_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "recursive_productivity_report_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "rejection_conditioned": {
          "type": "boolean"
        },
        "schema_id": {
          "const": "runtime.v4.phase14.attempt_summary.v1"
        },
        "update_family": {
          "enum": [
            "model_weights",
            "memory_retrieval",
            "generator_planner",
            "adapter_optimizer"
          ]
        },
        "verdict": {
          "enum": [
            "accept",
            "reject"
          ]
        }
      },
      "required": [
        "schema_id",
        "global_attempt_index",
        "challenge_index",
        "challenge_commitment_hash",
        "local_attempt_index",
        "update_family",
        "program_variant",
        "program_hash",
        "proposal_enumeration_hash",
        "candidate_semantic_package_hash",
        "candidate_phase6_tree_hash",
        "verdict",
        "reason_codes",
        "hidden_task_report_hash",
        "gate_d_report_hash",
        "gate_e_report_hash",
        "recursive_productivity_report_hash",
        "active_store_package_hash_before",
        "active_store_package_hash_after",
        "phase7_ledger_entry_hash",
        "rejection_conditioned"
      ],
      "type": "object"
    }
  },
