{
  "$defs": {
    "file": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "schema_id": {
          "const": "runtime.v4.phase14.bundle_file.v1"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "path",
        "size_bytes",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/n9269017/rcp-rclm/blob/main/python/rcp_rclm_executable_core_v4/contract/phase_14_bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "empty_directories": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "files": {
      "items": {
        "$ref": "#/$defs/file"
      },
      "minItems": 1,
      "type": "array"
    },
    "manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_id": {
      "const": "runtime.v4.phase14.bundle_manifest.v1"
    },
    "source_head": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "source_tree": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "trajectory_report_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "source_head",
    "source_tree",
    "trajectory_report_hash",
    "files",
    "empty_directories",
    "manifest_hash"
  ],
  "title": "RCP/RCLM Phase 14 content-addressed bundle manifest",
  "type": "object"
}
