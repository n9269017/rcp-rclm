{
  "$defs": {
    "case": {
      "additionalProperties": false,
      "properties": {
        "attack_id": {
          "minLength": 1,
          "type": "string"
        },
        "reason_class": {
          "minLength": 1,
          "type": "string"
        },
        "rejected": {
          "const": true
        },
        "schema_id": {
          "const": "runtime.v4.phase15.attack_case.v1"
        }
      },
      "required": [
        "schema_id",
        "attack_id",
        "rejected",
        "reason_class"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/n9269017/rcp-rclm/blob/main/python/rcp_rclm_executable_core_v4/contract/phase_15_attack_suite.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted": {
      "const": true
    },
    "attack_count": {
      "const": 12
    },
    "bundle_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/case"
      },
      "maxItems": 12,
      "minItems": 12,
      "type": "array"
    },
    "gate_e_closed": {
      "const": false
    },
    "phase15_exit_closed": {
      "const": false
    },
    "report_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_id": {
      "const": "runtime.v4.phase15.attack_suite.v1"
    },
    "source_head": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "source_head",
    "bundle_manifest_hash",
    "cases",
    "attack_count",
    "accepted",
    "phase15_exit_closed",
    "gate_e_closed",
    "report_hash"
  ],
  "title": "RCP/RCLM Phase 15 adversarial suite",
  "type": "object"
}
