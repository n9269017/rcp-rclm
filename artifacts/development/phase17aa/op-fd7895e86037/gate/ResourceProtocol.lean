-- Fresh AA packet SHA256: cb46c31c5a2e7a1714f6aee0cf57751de1cf56c514bd4b4fbb36a0a6d8bd3ec5
def bytesLE (count packed : Nat) : List Nat :=
  match count with
  | 0 => []
  | n + 1 => (packed % 256) :: bytesLE n (packed / 256)
termination_by structural count

