      record.program.json = target.image ∧ record.program.digest = target.rowPublic.key)
      rowRecords rowTargets := by
  exact project_rows all_rows_checked (fun _ _ checked =>
    ⟨checked.2.2.1, checked.2.2.2.1, checked.2.2.2.2.2.1⟩)

